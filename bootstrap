#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1:---dry-run}" in
    --dry-run)
        echo 'Bootstrap preview: install packages, initialize chezmoi, apply configs, restore runtimes and VS Code extensions, run doctor.'
        "$ROOT/setup" packages
        echo 'Then: ./setup init --write && ./setup apply --write'
        echo 'Then: ./setup runtimes --write && ./setup vscode --write && ./doctor'
        echo 'macOS preferences are a separate optional step: ./setup macos --write' ;;
    --write)
        [ "$(uname -s)" = Darwin ] || { echo 'This bootstrap is for macOS.' >&2; exit 1; }
        xcode-select -p >/dev/null 2>&1 || { echo 'Run xcode-select --install, then rerun.' >&2; exit 1; }
        if ! command -v brew >/dev/null 2>&1; then
            if [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"
            elif [ -x /usr/local/bin/brew ]; then eval "$(/usr/local/bin/brew shellenv)"
            else echo 'Install Homebrew from https://brew.sh, then rerun.' >&2; exit 1; fi
        fi
        "$ROOT/setup" packages --write
        "$ROOT/setup" init --write
        "$ROOT/setup" apply --write
        "$ROOT/setup" runtimes --write
        "$ROOT/setup" vscode --write
        "$ROOT/doctor" ;;
    *) echo 'Usage: ./bootstrap [--dry-run|--write]' >&2; exit 2 ;;
esac
