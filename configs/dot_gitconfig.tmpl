[user]
    name = {{ .identity.name | quote }}
    email = {{ .identity.email | quote }}

[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    dark = true
    line-numbers = true
    side-by-side = false
    syntax-theme = ansi

[include]
    path = ~/.gitconfig.local
