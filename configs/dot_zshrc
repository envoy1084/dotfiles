# Interactive terminals only; agent commands run without prompt/plugin setup.
[[ -o interactive && -t 0 && -t 1 ]] || return 0

# Find Homebrew in login and non-login shells on Apple Silicon and Intel.
typeset -g _dotfiles_brew_prefix="${HOMEBREW_PREFIX:-}"
if [[ ! -x "${_dotfiles_brew_prefix}/bin/brew" ]]; then
    if [[ -x /opt/homebrew/bin/brew ]]; then
        _dotfiles_brew_prefix=/opt/homebrew
    elif [[ -x /usr/local/bin/brew ]]; then
        _dotfiles_brew_prefix=/usr/local
    else
        _dotfiles_brew_prefix=''
    fi
fi
typeset -U path fpath
if [[ -n $_dotfiles_brew_prefix ]]; then
    path=("$_dotfiles_brew_prefix/bin" "$_dotfiles_brew_prefix/sbin" $path)
    fpath=("$_dotfiles_brew_prefix/share/zsh/site-functions" $fpath)
fi

# Local history, shared between terminals. A leading space skips saved history.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY SHARE_HISTORY EXTENDED_HISTORY
setopt HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS HIST_FIND_NO_DUPS
setopt HIST_EXPIRE_DUPS_FIRST HIST_REDUCE_BLANKS HIST_IGNORE_SPACE
setopt AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT INTERACTIVE_COMMENTS NO_BEEP

# Native completion with Homebrew's completions and a machine-local cache.
typeset -g _dotfiles_zsh_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$_dotfiles_zsh_cache"
autoload -Uz compinit
compinit -d "$_dotfiles_zsh_cache/zcompdump-$ZSH_VERSION"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{blue}%d%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$_dotfiles_zsh_cache/completions"

# Emacs-style input. Keep Option word navigation and prefix-history arrows.
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^[[C' forward-char
bindkey '^[OC' forward-char
bindkey '^[[D' backward-char
bindkey '^[OD' backward-char
bindkey '^[b' backward-word
bindkey '^[f' forward-word
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line
bindkey '^W' backward-kill-word
bindkey '^U' backward-kill-line

# Fuzzy history/file search. fd respects ignore files; .git stays excluded.
if (( $+commands[fzf] )); then
    export FZF_DEFAULT_OPTS='--height=45% --layout=reverse --border=rounded --info=inline --color=fg:#c0caf5,bg:#1a1b26,hl:#bb9af7,fg+:#c0caf5,bg+:#292e42,hl+:#7dcfff,border:#565f89,prompt:#7aa2f7,pointer:#ff9e64,marker:#9ece6a,spinner:#bb9af7,header:#9ece6a'
    if (( $+commands[fd] )); then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
        export FZF_CTRL_T_COMMAND='fd --hidden --exclude .git'
        _fzf_compgen_path() { fd --hidden --exclude .git . "$1"; }
        _fzf_compgen_dir() { fd --type d --hidden --exclude .git . "$1"; }
    fi
    if (( $+commands[bat] )); then
        export FZF_CTRL_T_OPTS="--preview 'if [ -d {} ]; then ls -Ap -- {}; else bat --color=always --style=numbers --line-range=:200 -- {}; fi' --preview-window=right:55%:wrap --bind=ctrl-/:toggle-preview"
    fi
    # Use zoxide's zi for directory selection; leave Option+C available.
    export FZF_ALT_C_COMMAND=''
    source <(fzf --zsh)
fi

if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh)"
fi

# Small interactive conveniences; standard commands keep their usual meaning.
alias ..='cd ..'
alias ...='cd ../..'
alias ll='ls -lah'
alias gs='git status --short --branch'
alias gd='git diff'
alias gl='git log --oneline --decorate -15'

# Work/machine-specific interactive additions stay outside Git.
[[ ! -f "$HOME/.zshrc.local" ]] || source "$HOME/.zshrc.local"

if [[ -f "$_dotfiles_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#565f89'
    source "$_dotfiles_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if (( $+commands[starship] )); then
    eval "$(starship init zsh)"
fi

# Syntax highlighting must be the last plugin loaded.
if [[ -f "$_dotfiles_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "$_dotfiles_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
