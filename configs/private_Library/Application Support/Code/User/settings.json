{
  "workbench.colorTheme": "EnvoyOS Theme",
  "js/ts.referencesCodeLens.enabled": true,
  "files.associations": {
    ".env*": "dotenv",
    "*.css": "tailwindcss",
    "*.json": "jsonc",
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [],
  },
  "workbench.preferredDarkColorTheme": "EnvoyOS Theme",
  "workbench.sideBar.location": "right",
  "files.autoSave": "afterDelay",
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "editor.cursorStyle": "block",
  "editor.formatOnSave": true,
  "notebook.formatOnSave.enabled": true,
  "files.autoSaveDelay": 200,
  "editor.minimap.enabled": true,
  "workbench.list.smoothScrolling": true,
  "editor.wordWrap": "on",
  "workbench.colorCustomizations": {},
  "editor.cursorBlinking": "smooth",
  "workbench.editor.highlightModifiedTabs": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "solidity.formatter": "forge",
  "solidity.validationDelay": 1,
  "cSpell.userWords": [
    "abiflow",
    "blockscout",
    "CAIP",
    "Devnet",
    "DKSAP",
    "Ensforge",
    "envoyos",
    "Euint",
    "farcaster",
    "fhevm",
    "hackyard",
    "IERC",
    "keypair",
    "kora",
    "namera",
    "Neynar",
    "Nuqs",
    "Offchain",
    "PIMLICO",
    "Resolvio",
    "secp",
    "Siwe",
    "sourcedocs",
    "sourcedocsrc",
    "squircle",
    "Stackout",
    "Subnames",
    "tfhe",
    "Timelocks",
    "usepreface",
    "VITE",
    "wagmi",
    "walletconnect",
  ],
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "editor.linkedEditing": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.editorAssociations": {
    "*.svg": "default",
  },
  "json.schemas": [
    {
      "fileMatch": [
        "tsconfig.json"
      ],
      "url": "https://json.schemastore.org/tsconfig",
    },
    {
      "fileMatch": [
        "package.json"
      ],
      "url": "https://json.schemastore.org/package.json",
    },
  ],
  "liveServer.settings.donotShowInfoMsg": true,
  "js/ts.suggest.paths": false,
  "workbench.iconTheme": "material-icon-theme",
  "window.newWindowProfile": "Default",
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
  },
  "json.schemaDownload.trustedDomains": {
    "https://biomejs.dev": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://openapi.vercel.sh": true,
    "https://raw.githubusercontent.com": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://spec.openapis.org/": true,
    "https://turbo.build": true,
    "https://turborepo.com": true,
    "https://ui.shadcn.com": true,
    "https://unpkg.com": true,
    "https://www.schemastore.org/": true
  },
  "workbench.browser.openLocalhostLinks": false,
  "security.workspace.trust.untrustedFiles": "open",
  "chat.disableAIFeatures": true,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
  "files.exclude": {
    "**/.next": true,
    "**/.tanstack": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/node_modules": true,
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
  },
}