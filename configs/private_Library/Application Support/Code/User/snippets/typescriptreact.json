	// forward ref component snippet with arrow component typescript syntax
	"React forwardRef Arrow Export Component": {
		"prefix": "rafrec",
		"body": [
			"import React from 'react';",
			"",
			"type Props = {};",
			"",
			"const $1 = React.forwardRef<${2:HTMLDivElement}, ${3:Props}>((props, ref) => {",
			"  return <div ref={ref} {...props}>$0</div>",
			"});",
			"",
