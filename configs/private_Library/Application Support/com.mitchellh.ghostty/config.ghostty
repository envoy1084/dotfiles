# Appearance
theme = TokyoNight Night
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
window-padding-x = 10
window-padding-y = 8
mouse-hide-while-typing = true

# Left Option sends Alt to the shell; right Option keeps macOS character input.
macos-option-as-alt = left

# Restore window/tab/split structure; running commands are not restored.
window-save-state = always

# Notify when a long command finishes while its terminal is unfocused.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# Right Command becomes Control+Option+Command through OmniWM.
# Global shortcuts require Ghostty running with Accessibility permission.
keybind = global:ctrl+alt+super+enter=new_window

# Local shortcuts; use left Command while OmniWM handles right Command.
keybind = super+shift+e=equalize_splits
keybind = super+shift+r=prompt_tab_title
keybind = super+shift+l=write_scrollback_file:open
